graph TB
    subgraph "Client"
        B[Browser Cache]
    end
    
    subgraph "Edge"
        CDN[CDN Edge Cache]
    end
    
    subgraph "Application Layer"
        APP[Application Server]
        LC[Local In-Memory Cache]
    end
    
    subgraph "Distributed Cache"
        R[Redis Cluster]
    end
    
    subgraph "Data Layer"
        DB[(Primary Database)]
    end
    
    U[User Request] --> B
    B -->|miss| CDN
    CDN -->|miss| APP
    APP --> LC
    LC -->|miss| R
    R -->|miss| DB
    
    style B fill:#e1f5ff
    style CDN fill:#ffe1e1
    style LC fill:#fff4e1
    style R fill:#e1ffe1
    style DB fill:#f0e1ff
