        <mxCell id="H2-LHizYDH277eCy7kqv-74" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;" value="Derivative are point in the direction of increase or decrease of mathematical functions. it tells to way to move to minimze the error" vertex="1">
