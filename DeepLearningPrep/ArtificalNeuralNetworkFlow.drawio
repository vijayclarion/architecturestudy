        </mxCell>
        <mxCell id="V5_eXnDy31Z662v7uYTC-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;" value="&lt;div&gt;&lt;b&gt;The formula basics:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; z[L] = W[L] × X + b[L]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Where:&lt;/div&gt;&lt;div&gt;&amp;nbsp; L&amp;nbsp; &amp;nbsp; &amp;nbsp; = layer number (1, 2, 3, 4)&lt;/div&gt;&lt;div&gt;&amp;nbsp; W[L]&amp;nbsp; &amp;nbsp;= weight matrix for layer L&lt;/div&gt;&lt;div&gt;&amp;nbsp; X&amp;nbsp; &amp;nbsp; &amp;nbsp; = input from previous layer&lt;/div&gt;&lt;div&gt;&amp;nbsp; b[L]&amp;nbsp; &amp;nbsp;= bias for layer L&lt;/div&gt;&lt;div&gt;&amp;nbsp; z[L]&amp;nbsp; &amp;nbsp;= output of layer L BEFORE activation&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;After this, apply activation:&lt;/div&gt;&lt;div&gt;&amp;nbsp; a[L] = g(z[L])&amp;nbsp; &amp;nbsp; ← ReLU for hidden, Linear for output&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="440" x="50" y="-390" as="geometry" />
        </mxCell>
        <mxCell id="V5_eXnDy31Z662v7uYTC-3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Matrix Rules&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;W[L] shape = (neurons in layer L, neurons in layer L-1)&lt;/div&gt;&lt;div&gt;b[L] shape = (neurons in layer L, 1)&lt;/div&gt;&lt;div&gt;z[L] shape = (neurons in layer L, 1)&amp;nbsp; &amp;nbsp;← for ONE example&lt;/div&gt;&lt;div&gt;a[L] shape = (neurons in layer L, 1)&amp;nbsp; &amp;nbsp;← same as z[L]&lt;/div&gt;" vertex="1">
