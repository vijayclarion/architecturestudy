        <mxCell id="t7yS3ZMoOpnFXq2jLA4X-18" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="869.04" width="814" x="36" y="2310" as="geometry" />
